# Copy these entries into your private .env; never commit credentials.
SEC_USER_AGENT=Your Name your.email@example.com

# Market data: LSEG requires Workspace running and signed in on this computer.
LSEG_APP_KEY=
# Alternative: WRDS PostgreSQL credentials and access to Compustat North America.
WRDS_USERNAME=
WRDS_PASSWORD=

# Optional: enables the four separate live model-role calls.
API_KEY=
OPENAI_MODEL=gpt-4o
